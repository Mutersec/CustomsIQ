CUSTOMSIQ_DATABASE_PATH=customsiq.db
CUSTOMSIQ_LOG_LEVEL=INFO
# Minimum name-similarity score (0-1) for a sanctions screening hit.
CUSTOMSIQ_SCREENING_THRESHOLD=0.75
# Opt-in PostgreSQL backend. When set, it wins over CUSTOMSIQ_DATABASE_PATH;
# unset (the default), CustomsIQ uses SQLite.
# CUSTOMSIQ_DATABASE_URL=postgresql://customsiq:customsiq@localhost:5432/customsiq
