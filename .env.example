CUSTOMSIQ_DATABASE_PATH=customsiq.db
CUSTOMSIQ_LOG_LEVEL=INFO
# Minimum name-similarity score (0-1) for a sanctions screening hit.
CUSTOMSIQ_SCREENING_THRESHOLD=0.75
# PBKDF2-HMAC-SHA256 work factor for password hashing. 600000 is OWASP's
# current recommendation for SHA-256 (~160 ms per hash on a laptop).
CUSTOMSIQ_PASSWORD_ITERATIONS=600000
# How long a session cookie stays valid.
CUSTOMSIQ_SESSION_TTL_HOURS=12
# Seed the four published demo accounts, but only into an empty users table.
# Set to false for a deployment with real accounts.
CUSTOMSIQ_SEED_DEMO_USERS=true
# Invoice upload limits (POST /extract-invoice). The size cap is enforced while
# streaming the request body, not from Content-Length.
CUSTOMSIQ_UPLOAD_MAX_BYTES=2097152
CUSTOMSIQ_UPLOAD_RATE_LIMIT_PER_MINUTE=10
# Opt-in PostgreSQL backend. When set, it wins over CUSTOMSIQ_DATABASE_PATH;
# unset (the default), CustomsIQ uses SQLite.
# CUSTOMSIQ_DATABASE_URL=postgresql://customsiq:customsiq@localhost:5432/customsiq
# Interactive API docs (/docs, /redoc, /openapi.json). Keep false in production.
CUSTOMSIQ_ENABLE_API_DOCS=false
# Sign-up verification e-mails, sent through Brevo's HTTP API (free tier).
# Create the key at brevo.com -> SMTP & API; MAIL_FROM must be a verified
# sender or an address on a domain you authenticated in Brevo.
# CUSTOMSIQ_BREVO_API_KEY=xkeysib-...
CUSTOMSIQ_MAIL_FROM=support@customsiq.org
# Local development only: write verification codes to the server log instead
# of e-mailing them. Never enable on a public deployment.
CUSTOMSIQ_MAIL_DEV_LOG_CODES=false
# "Sign in with Google": OAuth client ID (Web application) from Google Cloud
# Console. Unset, the Google button is hidden.
# CUSTOMSIQ_GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# Site owner(s) for the admin panel (/admin): comma-separated verified e-mails.
# CUSTOMSIQ_OWNER_EMAILS=you@example.com
# Days the per-user activity log is kept.
CUSTOMSIQ_ACTIVITY_RETENTION_DAYS=90
